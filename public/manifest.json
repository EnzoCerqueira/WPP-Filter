{
  "manifest_version": 3,
  "name": "WA Filter",
  "version": "1.0.0",
  "description": "Oculta mensagens no WhatsApp Web",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["assets/content.js"]
    }
  ]
}
